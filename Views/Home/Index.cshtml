@{
    ViewBag.Title = "Homepage";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container text-center cloud-bg" style="min-height: 100vh; padding: 40px 20px; border-radius: 0 0 30px 30px;">
    <div class="angel-halo mb-5">
        <img src="@Url.Content("~/Images/Icon.png")" alt="RescuePet Logo" width="100" height="100" class="mb-4 rounded-circle shadow" style="border: 3px solid #B0E0E6;">
        <h1 class="display-4 mb-3 sparkle-text heavenly-glow">Welcome to RescuePet</h1>
        <p class="lead text-muted fs-5" style="font-weight: 300;">Where every paw finds its eternal home</p>
        <img src="@Url.Content("~/Images/Home.png")" alt="RescuePet Logo" width="600" height="400" class="me-2rounded-square shadow" style="border: 3px solid #B0E0E6;">
    </div>

    <div class="mb-5">
        <a href="@Url.Action("Index", "Pets")" class="celestial-btn btn-lg shadow-sm">
            Meet Your Forever Friend
        </a>
    </div>

    <hr class="my-5 whisper-border" />

    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card floating-card border-0 shadow-lg">
                <div class="card-body text-center p-5">
                    <div class="angel-halo d-inline-block">
                        <h3 class="text-primary mb-4 heavenly-glow">Our Adoptions </h3>
                    </div>

                    <p class="lead mb-4">
                        <strong class="sparkle-text">@ViewBag.AdoptedCount</strong>
                        <span class="text-muted">souls are dancing in their forever homes</span>
                    </p>

                    <p class="pet-whisper mb-4 fs-5">
                        "Every adoption is a star born in our celestial sky"
                    </p>

                    <div class="table-responsive">
                        <table class="table table-hover mt-4 whisper-border">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-primary"> Guardian </th>
                                    <th class="text-primary">Forever Friend</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.RecentAdoptions != null && ViewBag.RecentAdoptions.Count > 0)
                                {
                                    foreach (var adoption in (IEnumerable<dynamic>)ViewBag.RecentAdoptions)
                                    {
                                        <tr>
                                            <td class="text-muted">@adoption.AdopterName</td>
                                            <td class="text-success fw-bold">@adoption.PetName</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="2" class="text-muted py-4">
                                            Waiting for our first eternal match...
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row mt-5">
        <div class="col-md-10 mx-auto">
            <div class="card floating-card border-0 shadow">
                <div class="card-body p-5">
                    <h4 class="text-primary mb-4 heavenly-glow">Our Mission</h4>
                    <p class="lead text-muted fs-6" style="line-height: 1.8;">
                        At RescuePet, we believe every creature deserves their own piece of heaven,
                        a warm lap to curl up on, gentle hands to stroke their fur, and a home where
                        their soul can truly sing. This isn't just adoption; it's divine connection.
                    </p>
                    <p class="pet-whisper mt-3">
                        Because every tail wag is a prayer answered
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5">
        <div class="d-flex justify-content-center gap-4 text-muted">
            <div class="text-center">
                <i class="bi bi-heart-fill fs-2 text-danger"></i>
                <p class="small mt-2">Love-First Approach</p>
            </div>
            <div class="text-center">
                <i class="bi bi-house-heart fs-2 text-primary"></i>
                <p class="small mt-2">Forever Homes</p>
            </div>
            <div class="text-center">
                <i class="bi bi-stars fs-2 text-warning"></i>
                <p class="small mt-2">Celestial Matches</p>
            </div>
        </div>
    </div>
</div>